{
  "name": "driver-safety-exam",
  "version": "1.0.0",
  "private": true,
  "description": "Driver safety exam — frontend + backend that emails the result automatically on submit.",
  "main": "server/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:render": "node server/index.js",
    "check-email": "node scripts/check-email.js",
    "build:worker-data": "node scripts/build-worker-data.js",
    "dev": "npm run build:worker-data && wrangler dev",
    "deploy": "npm run build:worker-data && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "puppeteer": "^25.11.0"
  },
  "devDependencies": {
    "wrangler": "^4.138.0"
  }
}
