{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "driver-safety-exam",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],

  // Serves public/index.html + public/assets/* directly from Cloudflare's
  // edge — no cold start, doesn't invoke the Worker at all. Only requests
  // that don't match a static file (i.e. POST /api/submit) fall through
  // to worker/index.js.
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS"
  },

  // Cloudflare Browser Run — lets worker/pdf.js drive a real (remote)
  // headless Chrome via @cloudflare/puppeteer to generate the result PDF.
  // Free plan: 10 min/day, 3 concurrent sessions.
  "browser": {
    "binding": "MYBROWSER"
  },

  // Employee database + exam attempts (see migrations/). This is now the
  // authoritative store — it superseded the SUBMISSIONS_KV backup below,
  // which is kept only because it's harmless to leave configured.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "driver-safety-exam-db",
      "database_id": "20012407-66f9-43b9-b940-5a1857466249",
      "migrations_dir": "migrations"
    }
  ],

  // Superseded by D1 (see above) — every submission is now stored durably
  // in exam_attempts. Left configured since it's unused-but-harmless;
  // worker/storage.js is no longer called.
  "kv_namespaces": [
    {
      "binding": "SUBMISSIONS_KV",
      "id": "a76916b6113243408cc2f350029a7acf"
    }
  ],

  // Result PDFs (superseded email attachments) — generated in the
  // background after each submission and served only through the
  // authenticated admin API, never publicly.
  "r2_buckets": [
    {
      "binding": "PDF_BUCKET",
      "bucket_name": "driver-safety-exam-pdfs"
    }
  ],

  // Email reporting to Efi has been fully replaced by the /admin
  // dashboard (see ADMIN.md) — these RESEND_* vars/secret are no longer
  // referenced by any code path, left configured only in case a future
  // feature wants email again; harmless to leave, safe to remove later.
  "vars": {
    "MAIL_TO": "efi@almogsea.co.il",
    "RESEND_FROM": "Driver Safety Exam <onboarding@resend.dev>"
  }
}
