# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000

# --- Resend (used to send the result email over HTTPS, not SMTP —
#     several free hosts, Render included, block outbound SMTP) ---
# 1. Sign up free at https://resend.com (no credit card needed)
# 2. Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional: the "From" address shown to the recipient. Without a verified
# domain in Resend, you can only send from their shared test address below.
# To send as your own domain (e.g. "Driver Exam <no-reply@almogsea.co.il>"),
# verify almogsea.co.il in Resend > Domains first.
RESEND_FROM=Driver Safety Exam <onboarding@resend.dev>

# Optional: override the recipient address (defaults to efi@almogsea.co.il)
MAIL_TO=
