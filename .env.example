# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000

# --- SMTP (used by nodemailer to send the result email) ---
# Example for Gmail with an App Password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your-16-char-app-password
#
# Example for a transactional provider (Brevo/SendGrid/Mailgun etc.) —
# use the SMTP credentials/relay they give you, same variables apply.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional: "From" address shown to the recipient (defaults to SMTP_USER)
SMTP_FROM=

# Optional: override the recipient address (defaults to efi@almogsea.co.il)
MAIL_TO=
